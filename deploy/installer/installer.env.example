# Tool Installer â€” non-secret configuration.
#
# Copy to installer.env and adjust for the host. Values here are NOT secrets;
# every credential is provided through Docker secret files mounted at
# /run/secrets (see docker-compose.yml and the deployment guide).

# --- Runtime ---------------------------------------------------------------
# Address the installer API listens on (internal network only).
INSTALLER_ADDR=:8090

# Docker network that installed tool containers join. Must match the network
# Core's gateway uses to reach tools (default: tools).
INSTALLER_TOOL_NETWORK=tools

# Working directory for package extraction and image builds (wiped on restart).
INSTALLER_WORK_DIR=/tmp/installer

# --- Secrets (paths inside the container, not values) ----------------------
# Bearer token Core sends when calling the installer API.
INSTALLER_TOKEN_FILE=/run/secrets/installer_token
# Database DSN used to register tools and record installs.
DB_DSN_FILE=/run/secrets/db_dsn
# Shared HMAC key directory (installer writes, Core reads).
TOOL_HMAC_KEYS_DIR=/run/secrets/tool-hmac
# Absolute path of the same directory ON THE DOCKER HOST (e.g.
# /srv/tools-bpbj/installer/secrets/tool-hmac). Tool containers bind-mount it
# and the daemon resolves bind sources against the host, not this container.
INSTALLER_HMAC_KEYS_HOST_DIR=

# --- Upload and resource policy -------------------------------------------
# Maximum accepted package size.
INSTALLER_MAX_UPLOAD_BYTES=67108864
# Seconds to wait for a freshly started tool to report healthy.
INSTALLER_HEALTH_TIMEOUT_SECONDS=90
# Per-tool container limits applied by the installer.
INSTALLER_MEMORY_LIMIT_MIB=512
INSTALLER_CPU_LIMIT=1.0
INSTALLER_PIDS_LIMIT=128

# Upstream hostnames the installer may register. Must match Core's
# UPSTREAM_ALLOWED_HOSTS, otherwise registration fails closed.
INSTALLER_UPSTREAM_ALLOWED_HOSTS=pdf-compressor

