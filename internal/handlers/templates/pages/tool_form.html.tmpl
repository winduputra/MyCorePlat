{{define "tool_form"}}{{template "layout" .}}{{end}}

{{define "content"}}
{{if .Error}}<div class="alert error" role="alert">{{.Error}}</div>{{end}}

<div class="page-head">
  <p class="meta">Isi detail tool. Slug, status, dan access tetap divalidasi di server.</p>
  <a class="btn ghost" href="/admin/tools">&larr; Kembali</a>
</div>

<div class="card">
  <div class="card-head"><h2>Detail Tool</h2></div>
  <div class="card-body">
    <form method="post" action="{{.FormAction}}">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <div class="form-grid">
        <div class="field">
          <label for="slug">Slug</label>
          <input id="slug" name="slug" value="{{.Tool.Slug}}" required pattern="[a-z0-9]+(-[a-z0-9]+)*">
          <span class="hint">Huruf kecil, angka, dan tanda hubung. Contoh: image-compressor</span>
        </div>
        <div class="field">
          <label for="name">Nama</label>
          <input id="name" name="name" value="{{.Tool.Name}}" required maxlength="128">
        </div>
        <div class="field full">
          <label for="description">Deskripsi</label>
          <textarea id="description" name="description" maxlength="512">{{deref .Tool.Description}}</textarea>
        </div>
        <div class="field">
          <label for="category">Kategori</label>
          <input id="category" name="category" value="{{deref .Tool.Category}}" maxlength="64">
        </div>
        <div class="field">
          <label for="version">Versi</label>
          <input id="version" name="version" value="{{deref .Tool.Version}}" maxlength="32">
        </div>
        <div class="field">
          <label for="runtime">Runtime</label>
          <select id="runtime" name="runtime">
            <option value=""{{if eq (deref .Tool.Runtime) ""}} selected{{end}}>-</option>
            <option value="python"{{if eq (deref .Tool.Runtime) "python"}} selected{{end}}>python</option>
            <option value="php"{{if eq (deref .Tool.Runtime) "php"}} selected{{end}}>php</option>
            <option value="node"{{if eq (deref .Tool.Runtime) "node"}} selected{{end}}>node</option>
            <option value="go"{{if eq (deref .Tool.Runtime) "go"}} selected{{end}}>go</option>
          </select>
        </div>
        <div class="field">
          <label for="access_type">Access</label>
          <select id="access_type" name="access_type">
            <option value="public"{{if or (eq .Tool.AccessType "public") (eq .Tool.AccessType "")}} selected{{end}}>public</option>
            <option value="token"{{if eq .Tool.AccessType "token"}} selected{{end}}>token</option>
          </select>
        </div>
        <div class="field full">
          <label for="upstream_url">Upstream URL</label>
          <input id="upstream_url" name="upstream_url" value="{{.Tool.UpstreamURL}}" required placeholder="http://service-name:8000">
          <span class="hint">Hanya hostname/alamat internal yang diizinkan (validasi SSRF).</span>
        </div>
        <div class="field">
          <label for="healthcheck_path">Healthcheck Path</label>
          <input id="healthcheck_path" name="healthcheck_path" value="{{.Tool.HealthcheckPath}}" required pattern="/.*">
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="draft"{{if or (eq .Tool.Status "draft") (eq .Tool.Status "")}} selected{{end}}>draft</option>
            <option value="active"{{if eq .Tool.Status "active"}} selected{{end}}>active</option>
            <option value="maintenance"{{if eq .Tool.Status "maintenance"}} selected{{end}}>maintenance</option>
            <option value="disabled"{{if eq .Tool.Status "disabled"}} selected{{end}}>disabled</option>
          </select>
        </div>
        <div class="field">
          <label for="display_order">Display Order</label>
          <input id="display_order" name="display_order" type="number" min="0" value="{{.Tool.DisplayOrder}}">
          <span class="hint">Urutan tampil di katalog (kecil lebih dulu).</span>
        </div>
        <div class="field full">
          <label for="maintenance_message">Maintenance Message</label>
          <textarea id="maintenance_message" name="maintenance_message" maxlength="512">{{deref .Tool.MaintenanceMessage}}</textarea>
          <span class="hint">Ditampilkan saat status tool = maintenance.</span>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn" type="submit">Simpan</button>
        <a class="btn ghost" href="/admin/tools">Batal</a>
      </div>
    </form>
  </div>
</div>
{{end}}