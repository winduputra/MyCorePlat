{{define "layout"}}<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} - Tools BPBJ</title>
  <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowGpMBqOoSnX0DqoTqNcQ1xkdLx6Hh4m5pD2H" crossorigin="anonymous"></script>
  <style>
    :root {
      --navy-900: #0f172a;
      --navy-800: #1e293b;
      --navy-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-400: #94a3b8;
      --slate-300: #cbd5e1;
      --slate-200: #e2e8f0;
      --slate-100: #f1f5f9;
      --slate-50: #f8fafc;
      --green-600: #16a34a;
      --green-700: #15803d;
      --green-500: #22c55e;
      --green-100: #dcfce7;
      --red-600: #dc2626;
      --red-100: #fee2e2;
      --amber-600: #d97706;
      --amber-100: #fef3c7;
      --blue-600: #2563eb;
      --blue-100: #dbeafe;
      --radius: 10px;
      --radius-sm: 6px;
      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
      --shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      --sidebar-w: 240px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      color: var(--navy-900);
      background: var(--slate-100);
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--green-700); text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      font-size: 0.85em;
      background: var(--slate-100);
      padding: 0.1em 0.35em;
      border-radius: var(--radius-sm);
      color: var(--navy-800);
    }

    /* ---- App shell ---- */
    .app { display: flex; min-height: 100vh; }

    /* ---- Sidebar ---- */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: linear-gradient(180deg, var(--navy-900), var(--navy-800));
      color: var(--slate-300);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 1.25rem 1.25rem;
      color: #fff;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .brand .mark {
      width: 34px; height: 34px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--green-500), var(--green-700));
      display: grid; place-items: center;
      font-weight: 700; color: #fff; font-size: 15px;
      flex-shrink: 0;
    }
    .brand .name { font-weight: 600; font-size: 1.05rem; letter-spacing: 0.01em; line-height: 1.15; }
    .brand .sub { display: block; font-size: 0.68rem; font-weight: 400; color: var(--slate-400); letter-spacing: 0.04em; text-transform: uppercase; }
    .nav { padding: 0.85rem 0.65rem; display: flex; flex-direction: column; gap: 0.15rem; }
    .nav-label {
      font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.09em;
      color: var(--slate-500); padding: 0.75rem 0.6rem 0.35rem;
    }
    .nav a {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.6rem 0.7rem;
      border-radius: var(--radius-sm);
      color: var(--slate-300);
      font-weight: 500;
      border-left: 3px solid transparent;
    }
    .nav a:hover { background: rgba(255,255,255,0.06); color: #fff; text-decoration: none; }
    .nav a.active { background: rgba(34,197,94,0.14); color: #fff; border-left-color: var(--green-500); }
    .nav a .ico { width: 18px; height: 18px; flex-shrink: 0; opacity: 0.9; }
    .sidebar-foot { margin-top: auto; padding: 1rem 1.25rem; font-size: 0.7rem; color: var(--slate-500); border-top: 1px solid rgba(255,255,255,0.08); }

    /* ---- Main column ---- */
    .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .topbar {
      background: #fff;
      border-bottom: 1px solid var(--slate-200);
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      position: sticky; top: 0; z-index: 10;
    }
    .crumb { display: flex; align-items: center; gap: 0.5rem; color: var(--slate-500); font-size: 0.8rem; }
    .crumb .sep { color: var(--slate-400); }
    .crumb .here { color: var(--navy-800); font-weight: 600; }
    .topbar h1 { margin: 0; font-size: 1.15rem; font-weight: 650; color: var(--navy-900); }
    .topbar-right { display: flex; align-items: center; gap: 0.85rem; }
    .account { display: flex; align-items: center; gap: 0.55rem; }
    .avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: var(--slate-200); color: var(--navy-700);
      display: grid; place-items: center; font-weight: 600; font-size: 0.8rem;
      border: 1px solid var(--slate-300);
    }
    .account .who { display: flex; flex-direction: column; line-height: 1.2; }
    .account .who .role { font-size: 0.7rem; color: var(--slate-500); }

    .content { padding: 1.6rem 1.5rem 3rem; max-width: 1200px; width: 100%; }

    /* ---- Buttons ---- */
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font: inherit; font-weight: 600; font-size: 0.82rem;
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      cursor: pointer;
      background: var(--green-600); color: #fff;
      transition: background 0.15s, box-shadow 0.15s;
      text-decoration: none;
      line-height: 1.2;
    }
    .btn:hover { background: var(--green-700); text-decoration: none; }
    .btn:focus-visible { outline: 2px solid var(--green-500); outline-offset: 2px; }
    .btn.secondary { background: #fff; color: var(--navy-700); border-color: var(--slate-300); }
    .btn.secondary:hover { background: var(--slate-50); }
    .btn.ghost { background: transparent; color: var(--slate-600); border-color: transparent; }
    .btn.ghost:hover { background: var(--slate-100); }
    .btn.danger { background: #fff; color: var(--red-600); border-color: var(--slate-300); }
    .btn.danger:hover { background: var(--red-100); border-color: var(--red-600); }
    .btn.small { padding: 0.32rem 0.6rem; font-size: 0.76rem; }

    /* ---- Cards ---- */
    .card {
      background: #fff;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      margin-bottom: 1.25rem;
    }
    .card-head {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--slate-200);
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    .card-head h2 { margin: 0; font-size: 1rem; font-weight: 650; color: var(--navy-900); }
    .card-body { padding: 1.25rem; }
    .card-body.flush { padding: 0; }

    /* ---- Page header ---- */
    .page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .page-head .meta { color: var(--slate-500); font-size: 0.83rem; margin: 0.2rem 0 0; }

    /* ---- Alerts ---- */
    .alert {
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
      font-size: 0.85rem;
      border: 1px solid transparent;
      display: flex; gap: 0.5rem; align-items: flex-start;
    }
    .alert.error { background: var(--red-100); color: #991b1b; border-color: #fecaca; }
    .alert.success { background: var(--green-100); color: #166534; border-color: #bbf7d0; }
    .alert.warn { background: var(--amber-100); color: #92400e; border-color: #fde68a; }
    .alert.info { background: var(--blue-100); color: #1e40af; border-color: #bfdbfe; }

    /* ---- Tables ---- */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    thead th {
      text-align: left;
      padding: 0.7rem 1rem;
      background: var(--slate-50);
      color: var(--slate-600);
      font-weight: 600;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--slate-200);
      white-space: nowrap;
    }
    tbody td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--slate-100); color: var(--navy-800); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: var(--slate-50); }
    .cell-actions { display: flex; gap: 0.4rem; align-items: center; justify-content: flex-end; }
    .empty { text-align: center; color: var(--slate-500); padding: 2.25rem 1rem; }
    .empty .big { font-size: 1rem; font-weight: 600; color: var(--navy-700); margin-bottom: 0.25rem; }

    /* ---- Badges ---- */
    .badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      padding: 0.18rem 0.55rem;
      border-radius: 999px;
      font-size: 0.72rem; font-weight: 600;
      border: 1px solid transparent;
      white-space: nowrap;
    }
    .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.75; }
    .badge.plain::before { display: none; }
    .badge.active { background: var(--green-100); color: #166534; border-color: #bbf7d0; }
    .badge.draft { background: var(--slate-100); color: var(--slate-600); border-color: var(--slate-200); }
    .badge.maintenance { background: var(--amber-100); color: #92400e; border-color: #fde68a; }
    .badge.disabled, .badge.revoked, .badge.unhealthy { background: var(--red-100); color: #991b1b; border-color: #fecaca; }
    .badge.healthy { background: var(--green-100); color: #166534; border-color: #bbf7d0; }
    .badge.token { background: var(--blue-100); color: #1e40af; border-color: #bfdbfe; }
    .badge.public { background: var(--slate-100); color: var(--slate-600); border-color: var(--slate-200); }
    .badge.expired { background: var(--amber-100); color: #92400e; border-color: #fde68a; }

    /* ---- Forms ---- */
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.25rem; }
    .field { display: flex; flex-direction: column; gap: 0.35rem; }
    .field.full { grid-column: 1 / -1; }
    .field label { font-weight: 600; font-size: 0.8rem; color: var(--navy-800); }
    .field .hint { font-size: 0.73rem; color: var(--slate-500); }
    input[type="text"], input[type="number"], input[type="date"], input[type="datetime-local"], select, textarea {
      font: inherit;
      font-size: 0.85rem;
      padding: 0.5rem 0.65rem;
      border: 1px solid var(--slate-300);
      border-radius: var(--radius-sm);
      background: #fff;
      color: var(--navy-900);
      width: 100%;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--green-500);
      box-shadow: 0 0 0 3px rgba(34,197,94,0.15);
    }
    textarea { min-height: 82px; resize: vertical; }
    .form-actions { display: flex; gap: 0.6rem; align-items: center; margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--slate-200); }

    /* ---- Filter bar ---- */
    .filter-bar { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)) auto; gap: 0.75rem; align-items: end; }
    .filter-bar .field label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--slate-500); }
    .filter-actions { display: flex; gap: 0.5rem; }

    /* ---- Token one-time panel ---- */
    .token-panel { border: 1px solid var(--green-500); background: linear-gradient(180deg, #f0fdf4, #fff); }
    .token-panel .token-value {
      display: block;
      word-break: break-all;
      background: var(--navy-900);
      color: #e2e8f0;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      margin: 0.75rem 0;
    }

    /* ---- Pagination ---- */
    .pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1.25rem; border-top: 1px solid var(--slate-200); font-size: 0.82rem; color: var(--slate-600); }
    .pager .links { display: flex; gap: 0.5rem; }

    /* ---- Utility ---- */
    .muted { color: var(--slate-500); }
    .nowrap { white-space: nowrap; }
    .mono { font-family: "SFMono-Regular", Consolas, monospace; }
    .stack-sm { display: flex; flex-direction: column; gap: 0.15rem; }
    .row-between { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }

    /* ---- Mobile ---- */
    .menu-toggle { display: none; background: #fff; border: 1px solid var(--slate-300); border-radius: var(--radius-sm); padding: 0.4rem 0.55rem; cursor: pointer; }
    @media (max-width: 880px) {
      .sidebar {
        position: fixed; left: 0; top: 0; z-index: 50;
        transform: translateX(-100%);
        transition: transform 0.2s ease;
        box-shadow: var(--shadow);
      }
      .sidebar.open { transform: translateX(0); }
      .menu-toggle { display: inline-flex; }
      .content { padding: 1.25rem 1rem 3rem; }
      .form-grid { grid-template-columns: 1fr; }
      .filter-bar { grid-template-columns: 1fr 1fr; }
      .account .who { display: none; }
    }
    @media (max-width: 560px) {
      .filter-bar { grid-template-columns: 1fr; }
      .topbar h1 { font-size: 1rem; }
      .topbar { padding: 0.7rem 1rem; }
    }
  </style>
</head>
<body hx-headers='{"X-CSRF-Token": "{{.CSRFToken}}"}'>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <span class="mark">TB</span>
      <span class="name">Tools BPBJ<span class="sub">Biro PBJ Lampung</span></span>
    </div>
    <nav class="nav">
      <span class="nav-label">Menu</span>
      <a href="/admin/tools">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        Tools
      </a>
      <a href="/admin/activity">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
        Activity
      </a>
      <a href="/admin/health">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        Health
      </a>
    </nav>
    <div class="sidebar-foot">Tools BPBJ &middot; Panel Admin</div>
  </aside>

  <div class="main">
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <button class="menu-toggle" type="button" aria-label="Menu" onclick="document.getElementById('sidebar').classList.toggle('open')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <div>
          <div class="crumb"><span>Admin</span><span class="sep">/</span><span class="here">{{.Title}}</span></div>
          <h1>{{.Title}}</h1>
        </div>
      </div>
      <div class="topbar-right">
        <div class="account">
          <span class="avatar" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="who"><span>Admin</span><span class="role">SuperAdmin</span></span>
        </div>
        <form method="post" action="/admin/logout" style="margin:0">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button type="submit" class="btn secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            Logout
          </button>
        </form>
      </div>
    </header>
    <main class="content">
      {{template "content" .}}
    </main>
  </div>
</div>
<script>
  (function () {
    var path = window.location.pathname;
    var map = [
      { sel: 'a[href="/admin/tools"]', prefix: '/admin/tools' },
      { sel: 'a[href="/admin/activity"]', prefix: '/admin/activity' },
      { sel: 'a[href="/admin/health"]', prefix: '/admin/health' }
    ];
    map.forEach(function (m) {
      if (path === m.prefix || path.indexOf(m.prefix + '/') === 0) {
        var el = document.querySelector('.nav ' + m.sel);
        if (el) { el.classList.add('active'); }
      }
    });
  })();
</script>
</body>
</html>{{end}}
