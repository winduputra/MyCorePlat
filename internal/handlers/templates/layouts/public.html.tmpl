{{define "public_layout"}}<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} - Tools BPBJ</title>
<style>
:root{
  --navy-900:#0f172a;--navy-800:#1e293b;--navy-700:#334155;
  --green-600:#16a34a;--green-500:#22c55e;--green-700:#15803d;
  --slate-50:#f8fafc;--slate-100:#f1f5f9;--slate-200:#e2e8f0;
  --slate-400:#94a3b8;--slate-500:#64748b;--slate-700:#334155;
  --radius:12px;
}
*{box-sizing:border-box}
body{
  margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--slate-50);color:var(--navy-900);-webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none}
.site-header{
  background:linear-gradient(135deg,var(--navy-900),var(--navy-800));
  color:#fff;padding:1.25rem 1.5rem;
}
.site-header .inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:.9rem}
.brand-mark{
  width:40px;height:40px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,var(--green-500),var(--green-700));
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.95rem;letter-spacing:.02em;
}
.brand-text .name{font-weight:650;font-size:1.05rem;line-height:1.2}
.brand-text .sub{font-size:.75rem;color:var(--slate-400)}
.hero{max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem 1.25rem}
.hero h1{margin:0 0 .5rem;font-size:1.75rem;letter-spacing:-.02em}
.hero p{margin:0;color:var(--slate-500);max-width:60ch;line-height:1.6}
.grid{
  max-width:1100px;margin:0 auto;padding:0 1.5rem 4rem;
  display:grid;gap:1.1rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
}
.card{
  background:#fff;border:1px solid var(--slate-200);border-radius:var(--radius);
  padding:1.25rem;display:flex;flex-direction:column;gap:.6rem;
  transition:box-shadow .15s ease,border-color .15s ease,transform .15s ease;
}
.card:hover{border-color:var(--green-500);box-shadow:0 8px 24px rgba(15,23,42,.08);transform:translateY(-2px)}
.card .cat{
  align-self:flex-start;font-size:.68rem;font-weight:600;text-transform:uppercase;
  letter-spacing:.06em;color:var(--green-700);background:#dcfce7;
  padding:.2rem .5rem;border-radius:999px;
}
.card h2{margin:0;font-size:1.05rem;letter-spacing:-.01em}
.card .desc{margin:0;color:var(--slate-500);font-size:.875rem;line-height:1.55;flex:1}
.card .open{
  margin-top:.35rem;display:inline-flex;align-items:center;gap:.4rem;
  font-size:.85rem;font-weight:600;color:var(--green-700);
}
.card .open svg{width:14px;height:14px}
.empty{
  max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem 5rem;text-align:center;
  color:var(--slate-500);
}
.empty .box{
  background:#fff;border:1px dashed var(--slate-200);border-radius:var(--radius);
  padding:3rem 1.5rem;
}
.site-footer{
  border-top:1px solid var(--slate-200);padding:1.5rem;text-align:center;
  color:var(--slate-400);font-size:.8rem;
}
@media (max-width:600px){
  .hero{padding:1.75rem 1rem .75rem}
  .grid{padding:0 1rem 3rem;grid-template-columns:1fr}
  .site-header{padding:1rem}
}
</style>
</head>
<body>
<header class="site-header">
  <div class="inner">
    <div class="brand-mark">TB</div>
    <div class="brand-text">
      <div class="name">Tools BPBJ</div>
      <div class="sub">Biro Pengadaan Barang/Jasa Provinsi Lampung</div>
    </div>
  </div>
</header>
{{template "content" .}}
<footer class="site-footer">
  Tools BPBJ &middot; Biro Pengadaan Barang/Jasa Provinsi Lampung
</footer>
</body>
</html>{{end}}
